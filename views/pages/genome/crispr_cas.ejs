<% var cfg = JSON.parse(config) %> 
<% var genomelist = JSON.parse(gid_list) %>
<% var cdata = JSON.parse(crispr_data) %>
<%- include('../../partials/header_html'); %>

<body>
    <div id="loader" class="center-loader" style='z-index:1'></div>
    <div id='wrapper'>
    <%- include('../../partials/header_img'); %>
    <%- include('../../partials/navbar'); %>
    
    
    <div class='page-content' >
              
       <p class='title h3'>CRISPR-Cas systems detected in HOMD genomes</p>
       <span class='pull_right'>CRISPR-Cas data can be downloaded
       <a href='https://www.homd.org/ftp/crispr/V2.0/'> from the FTP site here.</a> Other download options <a href='/download/download/crispr'>here.</a></span><br>
    <center>
    <div class='project_decription'>
        CRISPR-Cas (Clustered Regularly Interspaced Short Palindromic Repeats and CRISPR-associated proteins) 
        systems constitute prokaryotic adaptive immune mechanisms that provide targeted protection against 
        invasive genetic elements, including bacteriophages and plasmids 
        (<a href='https://www.science.org/doi/10.1126/science.1138140' target='_blank'>Barrangou et al., 2007</a>). 
        In the oral cavity, where dense polymicrobial communities engage in continuous viral-host 
        interactions and horizontal gene transfer, CRISPR-Cas locus architectures record historical 
        viral exposures and evolutionary dynamics. To support the exploration of microbial 
        defense networks across oral taxa, eHOMD integrates an automated CRISPR-Cas detection engine that 
        dynamically maps CRISPR repeat-spacer arrays and associated Cas gene clusters across all reference genomes. 
        This analytical capability allows researchers to investigate host-phage co-evolution, profile 
        adaptive immune repertoires, and track functional genomic variability across oral and 
        aerodigestive microflora. The current result of the CRISPR-Cas system detection was done 
        with CCTyper (version 1.8.0) - an automatic detection and subtyping of CRISPR-Cas operons 
        with the default parameter (<a href='https://pubmed.ncbi.nlm.nih.gov/33275853/' target='_blank'>Russel et al., 2020</a>). 
        A total of 4,165 out of the 8,177  genomes annotated in HOMD were detected to possess the CRISPR-Cas system. 
        The results are tabulated into a table listing the genomes with detected CRISPR-Cas system and 
        links to the Genome Viewer and the original data output by CCTyper are also provided below.
    </div>
    </center>
        
    <div class='container'>  <!-- Bootstrap container-->
    <div class="row">
        <div class="col">
        <% if(parseInt(row_count) == parseInt(tcount)){ %>
           Row Count: <b><%- tcount %></b>
        <% }else{ %>
            Available Full Count: <b><%- tcount %></b>
           <br>Showing: <b><%- row_count %></b>
        <% } %>
        </div>
    <div class="col-5 search-box">
      <form id='crispr-search-form' method='post' action='crispr_table'>
      Search Names:
      <input id='search_input' name='search_input' style='border:1px solid gray;padding:5px;' type='text' maxlength='50' value='<%= search %>' placeholder="Enter search term..."\>
      <button class='button' type='submit' value='Go'>Go</button>
      &nbsp;&nbsp;&nbsp;&nbsp;<small><a href='crispr_table'>Reload Page</a></small>
      </form>

    </div>
    
    </div>
    </div>
       
 
       
       
       <div id='crispr-box'>
       <table id='crispr-table' class='table table-hover table-condensed sortable'>
       <thead>
        <tr>
            <th class='center col1'>Genome-ID</th>
            <th class='center col1'>Taxon-ID</th>
            <th class='col3'>Species</th>
            <th class='col3'>Strain</th>
            <th class='center col1'>Contigs</th>
            <th class='center'>Length<br>(bp)</th>
            <th class='center'>CRISPR-Cas<br>Count</th>
            <th class='center col1 sorttable_nosort'>FTP<br>Directory</th>
            
        </tr>
       </thead>
       <tbody>
       <% for(n in genomelist){ %>
       <% gid = genomelist[n].gid %>
       <% taxidfullname = 'HMT-'+("0000" + cdata[gid].otid).slice(-4); %>
       
       <tr>
            <td class='w-med'><a href='genome_description?gid=<%= gid %>'><%= gid %></a></td>
            <td class='w-sm' nowrap><a href='/taxa/tax_description?otid=<%= cdata[gid].otid %>'><%= taxidfullname %></a></td>
            <td class='w-exp ellipsis' title='<%= cdata[gid].organism %>'><i><%= cdata[gid].organism %></i></td>
            <td class='w-exp ellipsis' title='<%= cdata[gid].strain %>'><%= cdata[gid].strain %></td>
            <td class='w-vsm'><%= cdata[gid].contigs %></td>
            <td class='w-sm'><%= cdata[gid].length.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); %></td>
            
            <td class='w-sm' sorttable_customkey="<%= cdata[gid].hit_count %>">
               <button class='button' onclick="get_ajax('<%= gid %>')"><%= cdata[gid].hit_count %> rows</button>
             </td>
             
            
           <td class='center'>
             <a href="<%= cfg.HOMD_URL_BASE %><%= cfg.CRISPR_PATH %><%= gid %>/" target='_blank'>open ftp site
              
            </a>
          </td>
       </tr>
           
       <% } %>
       </tbody>
       </table>
       
       </div>
    


    <div id='sub-table-div'>XXXX</div>
    </div> <!-- end: page-content -->
    
    <div id='footer'>
         <%- include('../../partials/footer'); %>
    </div>
       
</body>

</html>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script type="text/javascript" src="/js/menu.js"></script>
<script type="text/javascript" src="/js/genomes.js"></script>
<script type="text/javascript" src="/js/sorttable.js"></script> <!-- https://www.kryogenix.org/code/browser/sorttable -->
<script>
  mainmenu()
  var jb_path = '<%- cfg.JBROWSE_URL %>'
  
  function get_ajax(gid){
      let args = {}
      args.gid = gid
      var xmlhttp = new XMLHttpRequest();
      xmlhttp.open("POST", "/genome/crispr_ajax", true);
      xmlhttp.setRequestHeader("Content-type","application/json");
      xmlhttp.onreadystatechange = function() {
          if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
            var resp = xmlhttp.responseText;
            //console.log(resp)
            //window.open(url)
            disp = document.getElementById('sub-table-div')
            disp.innerHTML = resp
            disp.style.display = 'block'
            
          }
      }
      xmlhttp.send(JSON.stringify(args));
  }
  function close_sub_table(){
        disp = document.getElementById('sub-table-div')
        disp.style.display = 'none'
  }
  document.onreadystatechange = function() {
        // just three els to loader: this(js);css;html
        if (document.readyState !== "complete") {
            document.querySelector(
                '#crispr-box').style.display = "none";
            document.querySelector(
                "#loader").style.visibility = "visible";
        } else {
            document.querySelector(
                '#crispr-box').style.display = "block";
            document.querySelector(
                "#loader").style.visibility = "hidden";
            
        }
  };
  
    
</script>


