<style>
/* Fix the tax table header */
thead th { position: sticky; top: 0; }
#amr-table.sortable tbody {
    counter-reset: sortabletablescope;
}
#amr-table.sortable thead tr::before {
    content: "";
    display: table-cell;
    width:30px;
    /* padding-left:1px; */
    vertical-align: middle;
    color:white;
    /* background:  var(--table-header-bg); */
    padding:5px;
    font-size:13px;
    text-align: center;
}
#amr-table.sortable tbody tr::before {
    content: counter(sortabletablescope);
    counter-increment: sortabletablescope;
    display: table-cell;
    text-align:right;
    font-size:small;
}
 #amr-table
{
  padding:5px;
 /*  width:1200px; */
  table-layout:fixed;
  /* table-layout:auto */
  width:100%;
  /* background:lightgrey; */
}
#amr-table th
{
  color:white;
  background:  var(--table-header-bg);
  padding:5px;
  font-size:13px;
  text-align: center;
  z-index: .5;
}
#amr-table td
{
  padding:3px 2px 2px 5px;
  
  font-size:small;
  font-weight:bold;
  color: #303030;

  white-space: nowrap;
}
#amr-table .ellipsis{
  overflow: hidden;
  text-overflow: ellipsis;
}
#amr-table tr:nth-child(even) { 
    /* background-color: var(--table-row-even1); */
 } 
 
 #amr-table tr:hover { 
    background-color: #dce7f5; 
 } 


