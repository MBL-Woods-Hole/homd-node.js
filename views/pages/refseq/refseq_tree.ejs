<% svg = JSON.parse(svg_data) %>
<html><head><title>HOMD RefSeq Tree</title>

<meta charset="UTF-8">

</head><body>

	<!-- <object data="/trees/refseq_tree_V15.23.svg" type="image/svg+xml"></object> -->
	<!-- <img src="/trees/refseq_tree_V15.23.svg" type="image/svg+xml" width='100%' /> -->
	<%- svg %>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
var otid = "<%= otid %>"
taxidfullname = 'HMT-'+("0000" + otid).slice(-4);
// console.log(taxidfullname)
// let y = $("text:contains('"+taxidfullname+"')").css({"font-size":"120%","fill": "red", "background-color": "green" })
// let x = $("text:contains('"+taxidfullname+"')").closest("tspan").css({"background-color": "green" })
// //$("text:contains('"+taxidfullname+"')").css("background-color", "coral");
//window.scrollTo(0, $("text:contains('"+taxidfullname+"')").offset().top-50)

var regex
var ln = otid.length
//console.log('ln', ln,otid)
if(ln === 1){
  // search for HMT-00x and HMT-000x
  regex = new RegExp(`HMT-0{2,3}${otid}`, "gi"); 
}else if(ln === 2){
  // search for HMT-0xx and HMT-00xx
  regex = new RegExp(`HMT-0{1,2}${otid}`, "gi"); 
}else if(ln === 3){
   // search for HMT-xxx and HMT-0xxx
   regex = new RegExp(`HMT-0{0,1}${otid}`, "gi"); 
}else if(ln === 4){
   // search for HMT-xxxx
   regex = new RegExp(`HMT-0{1,2}${otid}`, "gi"); 

}else{
  // error
}


function scrollToTspanRegex(regex) {
  // 1. Select all <tspan> elements in the document
  const tspans = document.querySelectorAll('tspan');
  
  // 2. Iterate through them to find a match using the regex
  for (const tspan of tspans) {
    const text = tspan.textContent || '';
    
    if (regex.test(text)) {
      // 3. Scroll smoothly to the matching element
      tspan.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      // Optional: highlight the element temporarily
      tspan.style.transition = 'fill 0.3s';
      tspan.style.fill = 'red';
      
      console.log('Scrolled to tspan with text:', text);
      //return tspan; // Stop after the first match
    }
  }
  
  return null;
}
scrollToTspanRegex(regex);
</script>

</body>
</html>
 


