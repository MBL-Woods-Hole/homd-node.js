<style>
.container {
  display: grid;
  grid-template-columns: auto;
  background-color: white;
  padding:40px 0;
  
}

.container div {
  background-color: white;
  width: 350px;
  margin: 2px;
  /* margin-left: 200px; */
  padding: 20px;

  text-align: left;  
  font-size: 20px;
  
}
table {
    table-layout: fixed;   /* Enforces fixed column sizing */
    width:800px;         /* Table must have an explicit or percentage width */
    border-collapse: collapse;
}
.fixed-col1 {
    width: 250px; 
  }

  /* Handle content that is too long for the fixed width */
td {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border:1px solid red;
  }
table th td {
  /* border-bottom: 1pt solid black; */
  border:1px solid red;
}

.underline{
    border-bottom: 1px solid lightgrey;
}
.spaced-row td{
    padding:10px 0;
    
    
}
.text-right {
    text-align: right;
}
.pad-left50{
   padding-left:50px;
}
.pad-left25{
   padding-left:25px;
}
.bold{
   /* font-family: "Lucida Console", "Courier New", monospace; */
   font-weight:bold;
}
#taxon-area{
   background: #deebf6;
}
#genomics-area{
   background: #fff1cd;
}
#pangenomics-area{
   background: #e3efda;
}
#rrna16s-area{
   background: #f9d2ba;
}
#ecology-area{
   background: #fec6ef;
}
#phage-area{
   background: #dedbf6;
}
.tooltip_templates { display: none; }

#tooltip_content ul{
  background:lightgrey;
  padding:8px;
  color:black;
}
.head{
   font-size: 24px;
   font-weight:bold;
   
}

.hilight{
   padding:6px 25px;
}
.hilight50{
   padding:6px 50px;
}
.white{
    background: white;
}
.line{
    border-bottom: 1px solid black;
}
.classic-select{
  width:150px; 
}

</style>

<%- include('../../partials/header_html'); %>

<% data_lookup = JSON.parse(data1) %>
<% data_pubs = JSON.parse(data4) %>
<% data_info = JSON.parse(tinfo) %>
<% data_lineage = JSON.parse(lin) %>
<% data_refseq = JSON.parse(refseq_info) %>
<% links = JSON.parse(links) //refseq  %>
<% sites = JSON.parse(sites) %>
<% gstrains = JSON.parse(strains) %>
<% sites2 = JSON.parse(sites2) %>
<% taxidfullnameplus = "HMT-"+("0000" + otid).slice(-4); %>
<% cfg = JSON.parse(config) %>

<% images = JSON.parse(image_array)  %>
<!-- <link rel="stylesheet" type="text/css" href="tooltipster/dist/css/tooltipster.bundle.min.css" /> -->
<body>
    <link rel="stylesheet" type="text/css" href="/css/tooltipster.bundle.min.css" />
<div id='wrapper'>
<%- include('../../partials/header_img'); %>
<%- include('../../partials/navbar'); %>
<div class='page-content' >
    <span class='back_btnx' ><a href='/taxa/taxon_table'>Taxon Table</a> | <a href='/genome/genome_table'>Genome Table</a></span>
  
  
  <p class='h3 title'>
    <i><%= data_lineage.species %> <%= data_lineage.subspecies %></i>
    (<%= taxidfullnameplus %>)
  </p>
  


  <center>
   <span id='lineage'>
    <%= data_lineage.domain %>;<%= data_lineage.phylum %>;<%= data_lineage.klass %>;<%= data_lineage.order %>;<%= data_lineage.family %>;<%= data_lineage.species %>
    <%= data_lineage.subspecies %>
   </span>
  </center>
  
  <div class="container">
    
    <div class='' id='taxon-area'>
        <table>
        <tr><th class='head fixed-col' nowrap>Taxonomy</th><th></th></tr>
        <tr class='underline'><td class='bold  hilight50'>Domain:</td>
            <td class='taxon-data white'><a href='life?rank=domain&name=<%= data_lineage.domain %>'><%= data_lineage.domain %></a></td>
        </tr>
        <tr class='underline'><td class='bold hilight50 '>Phylum:</td>
            <td class='taxon-data white'><a href='life?rank=phylum&name=<%= data_lineage.phylum %>'><%= data_lineage.phylum %></a></td>
        </tr>
        <tr class='underline'><td class='bold hilight50'>Class:</td>
            <td class='taxon-data white'>
            <a href='life?rank=klass&name=<%= data_lineage.klass %>'><%= data_lineage.klass %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold hilight50'>Order:</td>
            <td class='taxon-data white'>
            <a href='life?rank=order&name=<%= data_lineage.order %>'><%= data_lineage.order %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold hilight50'>Family:</td>
            <td class='taxon-data white'>
            <a href='life?rank=family&name=<%= data_lineage.family %>'><%= data_lineage.family %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold hilight50'>Genus:</td>
            <td class='taxon-data white'>
            <a href='life?rank=genus&name=<%= data_lineage.genus %>'><%= data_lookup.genus %></a>
            <% if(data_lineage.genus.includes("[")){ %>
            <span class="tooltip-tipster" data-tooltip-content="#tooltip_content">
            <img src="/images/question.png" width='20'>
            </span>
            <% } %>
            </td>
        </tr>
            <div class="tooltip_templates">
            <span id="tooltip_content">
            Bracketed letters indicate 
            <br>that the taxonomic name at this 
            <br>level has not been established.
            <ul>
            <li><small>Examples:</small>
            <li><small>C1 – First Unnamed Class</small>
            <li><small>O1 – First Unnamed Order</small>
            <li><small>F2 – Second Unnamed Family</small>
            <li><small>G3 – Third Unnamed Genus</small>
            </ul>
            </span>
            </div>
        <% if(data_lineage.subspecies){ %>
        <tr class='underline'><td class='bold hilight50'>Species:</td>
            <td class='taxon-data'> <a href='life?rank=species&name=<%= data_lineage.species %>'><%= data_lookup.species %></a></td>
        </tr>
        <tr class='underline'><td class='bold hilight50'>Subspecies:<br>or Clade:</td>
            <td class='taxon-data white'><%= data_lineage.subspecies %></td>
        </tr>
        <% }else{ %>
        <tr class='underline'><td class='bold hilight50'>Species:</td>
            <td class='taxon-data white'><%= data_lookup.species %></td>
        </tr>
        <% } %>
        <tr class='underline'><td class='bold hilight50' nowrap>Bacterial Name:</td>
            <td class='taxon-data white' nowrap><i><%= data_lineage.species %></i></td>
        </tr>
        
        
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class=''><td class='bold hilight'  nowrap>Taxonomic Rank link</td>
            <td class='taxon-data' nowrap>TBD</td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2' >&nbsp;</td>
        <tr class=''><td class='bold hilight' nowrap>HOMD/NCBI/GTDB</td>
            <td class='taxon-data' nowrap>TBD</td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2' >&nbsp;</td>
        <tr class=''><td class='bold hilight' nowrap>NCBI Taxon-ID</td>
            <td class='taxon-data' nowrap>
            <% if(!data_lookup.ncbi_taxid || parseInt(data_lookup.ncbi_taxid) == 0){ %>
                <small>Not Available</small>
            <% }else{ %>
                <span class='link'>
                    <a href='https://www.ncbi.nlm.nih.gov/datasets/taxonomy/<%= data_lookup.ncbi_taxid %>/' target='_blank' rel="noopener noreferrer"><%= data_lookup.ncbi_taxid %> </a>
                </span>
            <% } %>
            </td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class=''><td class='bold hilight' nowrap>LSPN Species Page</td>
            <td class='taxon-data' nowrap>
                <% link = "https://lpsn.dsmz.de/"+links["lpsnlink"] %>
                <% show = data_lineage.species %>
                <span>
                    <a class='link' href='<%- link %>' target='_blank' rel="noopener noreferrer"><em><%- link %></em></a>
                </span>
            </td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class=''><td class='bold hilight' nowrap>Type Strain(s)</td>
            <td class='taxon-data' nowrap>TBD</td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class=''><td class='bold hilight' nowrap>Former Names/Synonyms</td>
            <td class='taxon-data' nowrap>
            <table class='' border='0'>
                <% for(n=0;n<data_lookup.synonyms.length;n++){ %>
                <tr><td class='taxon-data' style='border:none;padding:0 1px;' nowrap><i><%- data_lookup.synonyms[n] %></i></td></tr>
                <% } %>
            </table>
            </td>
        </tr>
 
        </table>
       
    
    </div>
   
    
    <div class='' id='genomics-area'>
        <% g_length = data_lookup.genomes.length %>
        <table>
        <tr><td class='head fixed-col'>Genomics</td></tr>
        
        <tr class='underline'>
          <td class='bold hilight' nowrap>
              Taxon Genomes
              <% if(g_length !== 0){ %>
                (count <%= g_length %>)
              <% } %>
          </td>
            <td class='taxon-data' nowrap>
                
                
                <% if(g_length === 0){ %>
                    <small>No Genomes</small>
                <% }else{ %>
                    
                    <select class='dropdown-homd' onchange="if (this.value) window.location.href = this.value;">
                    <optgroup>
                    <option value=''>Select a genome</option>
                    <% for(n in data_lookup.genomes){ %>
                        <option value='/genome/genome_description?gid=<%= data_lookup.genomes[n] %>'>
                          <%= parseInt(n)+1 %>-
                          <%= data_lookup.genomes[n] %>
                          <%= gstrains[data_lookup.genomes[n]] %>
                        </option>
                    <% } %>
                    </optgroup>
                    </select>
                    
                    &nbsp;&nbsp;&nbsp;OR&nbsp;&nbsp;&nbsp;
                     <a class='td-button' href='/genome/genome_table?otid=<%= otid %>'>Open in Table</a>
                <% } %>
                
                
                
                
                
            </td>
        </tr>
        <tr class='' ><td class='bold hilight' nowrap>Phylogenetic Trees</td></tr>
           <tr class='underline '>
             <td class='pad-left50 ' nowrap>Conserved Proteins:</td>
             <td class='taxon-data' nowrap>
                <a class='link' href='/genome/conserved_protein_tree?otid=<%= otid %>' target='_blank'>Open</a>
             </td>
           </tr>
           <tr class='underline'>
             <td class='pad-left50 ' nowrap>Ribosomal Proteins:</td>
             <td class='taxon-data' nowrap>
                <a class='link' href='/genome/ribosomal_protein_tree?otid=<%= otid %>' target='_blank'>Open</a>
             </td>
          </tr>
        
        <tr class='' ><td class='bold hilight' nowrap>BLAST against</td></tr>
            
        <tr class='underline'><td class='pad-left50'>All Genomes:</td>
            <td>
             <a  href="<%= cfg.BLAST_URL_BASE %>/genome_blast">Open Genomic BLAST Server</a>
            </td>
        </tr>
        <tr class='underline'>
           <td class='pad-left50'>One Genome:</td>
           <td>
            <a class='td-button'     href='/genome/genome_table?otid=<%= otid %>'>Select Genome from Table</a>
           </td>
        </tr>
        </table>
    
    </div>
    
    <div class='' id='pangenomics-area'>
        <table>
        <tr><td class='head fixed-col'>Pangenomics</td></tr>
        
        <tr class='underline'><td class='bold hilight'>Preview (static image):</td>
            <td class='taxon-data' nowrap>
                <% if(data_lookup.pangenomes.length == 1 && data_lookup.pangenomes[0]){ %>
                    <a class='link' href='/genome/pangenome_image2?pg=<%= data_lookup.pangenomes[0].pg %>&ext=svg' target='_blank'>OpenSVG</a> 
                <% }else if(data_lookup.pangenomes.length > 1 && data_lookup.pangenomes[0]){ %>
                <% for(n in data_lookup.pangenomes){ %>
                    <a class='link' href='/genome/pangenome_image2?pg=<%= data_lookup.pangenomes[n].pg %>&ext=svg' target='_blank'>OpenSVG</a> 
                <%   } %>
                <% }else{ %>
                    <small>No Pangenomes Available.</small>
                <% } %>
            </td>
            <td>download</td>
        </tr>
        <tr class='underline'><td class='bold hilight'>Open Anvi`o (interactive):</td>
            <td class='taxon-data' nowrap>
                <% if(data_lookup.pangenomes.length == 1 && data_lookup.pangenomes[0]){ %>
                    <a class='link' href='/genome/anvio?pg=<%= data_lookup.pangenomes[0].pg %>' target='_blank'>Open</a> 
                <% }else if(data_lookup.pangenomes.length > 1 && data_lookup.pangenomes[0]){ %>
                <%   for(n in data_lookup.pangenomes){ %>
                    <a class='link' href='/genome/anvio?pg=<%= data_lookup.pangenomes[n].pg %>' target='_blank'>Open</a> 
                <%   } %>
                <% }else{ %>
                    <small>No Pangenomes Available.</small>
                <% } %>
            </td>
            
        </tr>
       </table>
    </div>
   
   <!-- 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA -->
    <div class='' id='rrna16s-area'>
      <table>
        <tr><td class='head fixed-col' nowrap>16S rRNA</td></tr>
        <tr class='underline'><td class='bold hilight' nowrap>Taxon RefSeqs</td>
            <td class='taxon-data white' >
                RefSeq-ID(s):
                <select class='dropdown-homd' onchange="get_refseqs(this.value)">
                <option value=''>Show Sequence</option>
                <% for(n in data_refseq){ %>
                    <% refseqid   = data_refseq[n].refseq_id %>
                    <% species    = data_refseq[n].species %>
                    <% seqids    = data_refseq[n].seqids %>
                    <option value='["<%= taxidfullnameplus %>","<%= refseqid %>","<%= species %>","<%= seqids %>"]'><%= refseqid %>
                    
                    </option>
                <% } %>
                </select>
            
            </td>
            <td>download</td>
        </tr>
        <tr class='underline'>
          <td class='bold hilight' nowrap>Phylogenic Trees</td><td></td>
        </tr>
        <tr class='underline'><td class='bold pad-left50'>Small Tree</td>
            <td class='taxon-data white'>
            TBD
            </td>
            <td>download</td>
        </tr>
        <tr class='underline'><td class='bold pad-left50' nowrap>All RefSeq Tree</td>
            <td class='taxon-data white'>
                <a href='/refseq/refseq_tree?otid=<%= otid %>' target='_blank'>View Taxon in RefSeq Tree</a>
            </td>
            <td>download</td>
        </tr>
        <tr class='underline'>
          <td class='bold hilight' nowrap>BLAST:</td>
          <td>
            <a class="dropdown-item" href="<%= cfg.BLAST_URL_BASE %>/refseq_blast" target="_self">Open RefSeq BLAST Server</a>
          </td>
        </tr>
        
      </table>
    </div>
    <!-- ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY -->
    <div class='' id='ecology-area'>
      <table>
        <tr><td class='head fixed-col' nowrap>Ecology</td></tr>
        <tr class='underline'>
          <td class='bold hilight' nowrap>Body Site/Habitat</td><td></td>
        </tr>
        <tr class='underline'><td class='bold pad-left50'>General</td>
            <td class='taxon-data white'><%- sites2.general_habitat %>
            
            </td>
        </tr>
        <tr class='underline'><td class='bold pad-left50' nowrap>Major body site</td>
            <td class='taxon-data white'><%- sites2.major_body_site %>
            &nbsp;&nbsp;&nbsp;
               &nbsp;<small>Julian's mapping page <a class='link' href=''>NEW</a></small>
            </td>
        </tr>
        <tr class='underline'><td class='bold pad-left50' nowrap>Major oral site</td>
            <td class='taxon-data white'><%- sites2.subsite_of_primary %>
            
            
            <% if(otid_has_abundance){ %>
               <% if(data_lineage.subspecies){ %>
                 <% ss = encodeURIComponent(data_lineage.subspecies) %>
                 <% rankname = "subspecies" %>
               <% }else{ %>
                 <% ss = encodeURIComponent(data_lineage.species) %>
                 <% rankname = "species" %>
               <% } %>
            &nbsp;&nbsp;&nbsp;
               &nbsp;<small>Graph: [<a class='link' href='ecology?rank=<%= rankname %>&name=<%= ss %>'>link</a>]</small>
               
            <% }else{ %>
                 [<small>No Abundance Data</small>]
            <% } %>
    
    
            </td>
        </tr>
        
      </table>
    </div>
    
    <!-- PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE -->
    <div class='' id='phage-area'>
      <table>
        <tr><td class='head fixed-col' nowrap>Phage</td></tr>
        <tr class='underline'>
          <td class='bold hilight' nowrap>Genomes with Phage</td>
          <td>TBD</td>
        </tr>
      </table>
    </div>
    
  </div>  <!-- End Container -->

  
</div> <!-- end: page-content -->
    
    <div id='footer'>
         <%- include('../../partials/footer'); %>
    </div>
  </div> <!-- end wrapper   -->
</body>
</html>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
