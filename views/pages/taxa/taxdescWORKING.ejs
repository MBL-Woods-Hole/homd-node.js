<style>
.container {
  display: grid;
  grid-template-columns: auto;
  background-color: white;
  
}

.container div {
  background-color: white;
  width: 350px;
  margin: 2px;
  /* margin-left: 200px; */
  padding: 20px;

  text-align: left;  
  font-size: 20px;
  
}
table {
  table-layout: fixed;   /* Enforces fixed column sizing */
              /* Table must have an explicit or percentage width */
    border-collapse: collapse;
}

table tr {
  /* border-bottom: 1pt solid black; */
}
.underline{
    border-bottom: 1px solid lightgrey;
}
.spaced-row td{
    padding:10px;
    
    
}
.text-right {
    text-align: right;
}
.bold{
   /* font-family: "Lucida Console", "Courier New", monospace; */
   font-weight:bold;
}
#taxon-area{
   background: #deebf6;
}
#genomics-area{
   background: #fff1cd;
}
#pangenomics-area{
   background: #e3efda;
}
#rrna16s-area{
   background: #f9d2ba;
}
#ecology-area{
   background: #fec6ef;
}
#phage-area{
   background: #dedbf6;
}
.tooltip_templates { display: none; }
#tooltip_content ul{
  background:lightgrey;
  padding:8px;
  color:black;
}
.head{
   font-size: 30px;
   font-weight:bold;
   width:200px;
}

.hilight{
   padding:2px 200px 2px 10px;
}
.white{
    background: white;
}
.line{
    border-bottom: 1px solid black;
}
</style>

<%- include('../../partials/header_html'); %>

<% data_lookup = JSON.parse(data1) %>
<% data_pubs = JSON.parse(data4) %>
<% data_info = JSON.parse(tinfo) %>
<% data_lineage = JSON.parse(lin) %>
<% data_refseq = JSON.parse(refseq_info) %>
<% links = JSON.parse(links) //refseq  %>
<% sites = JSON.parse(sites) %>
<% taxidfullnameplus = "HMT-"+("0000" + otid).slice(-4); %>
<% cfg = JSON.parse(config) %>

<% images = JSON.parse(image_array)  %>
<!-- <link rel="stylesheet" type="text/css" href="tooltipster/dist/css/tooltipster.bundle.min.css" /> -->
<body>
    <link rel="stylesheet" type="text/css" href="/css/tooltipster.bundle.min.css" />
<div id='wrapper'>
<%- include('../../partials/header_img'); %>
<%- include('../../partials/navbar'); %>
<div class='page-content' >
    <span class='back_btnx' ><a href='/taxa/taxon_table'>Taxon Table</a> | <a href='/genome/genome_table'>Genome Table</a></span>
  
  
  <p class='h3 title'>
    <i><%= data_lineage.species %> <%= data_lineage.subspecies %></i>
    (<%= taxidfullnameplus %>)
  </p>
  


  <center>
   <span id='lineage'>
    <%= data_lineage.domain %>;<%= data_lineage.phylum %>;<%= data_lineage.klass %>;<%= data_lineage.order %>;<%= data_lineage.family %>;<%= data_lineage.species %>
    <%= data_lineage.subspecies %>
   </span>
  </center>
  
  <div class="container">
    
    <div class='' id='taxon-area'>
        <table>
        <tr><td class='bold hilight head'>Taxonomy</td></tr>
        <tr class='underline'><td class='bold text-right hilight'>Domain:</td>
            <td class='taxon-data white'><a href='life?rank=domain&name=<%= data_lineage.domain %>'><%= data_lineage.domain %></a></td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight '>Phylum:</td>
            <td class='taxon-data white'><a href='life?rank=phylum&name=<%= data_lineage.phylum %>'><%= data_lineage.phylum %></a></td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>Class:</td>
            <td class='taxon-data white'>
            <a href='life?rank=klass&name=<%= data_lineage.klass %>'><%= data_lineage.klass %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>Order:</td>
            <td class='taxon-data white'>
            <a href='life?rank=order&name=<%= data_lineage.order %>'><%= data_lineage.order %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>Family:</td>
            <td class='taxon-data white'>
            <a href='life?rank=family&name=<%= data_lineage.family %>'><%= data_lineage.family %></a>
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>Genus:</td>
            <td class='taxon-data white'>
            <a href='life?rank=genus&name=<%= data_lineage.genus %>'><%= data_lookup.genus %></a>
            <% if(data_lineage.genus.includes("[")){ %>
            <span class="tooltip-tipster" data-tooltip-content="#tooltip_content">
            <img src="/images/question.png" width='20'>
            </span>
            <% } %>
            </td>
        </tr>
            <div class="tooltip_templates">
            <span id="tooltip_content">
            Bracketed letters indicate 
            <br>that the taxonomic name at this 
            <br>level has not been established.
            <ul>
            <li><small>Examples:</small>
            <li><small>C1 – First Unnamed Class</small>
            <li><small>O1 – First Unnamed Order</small>
            <li><small>F2 – Second Unnamed Family</small>
            <li><small>G3 – Third Unnamed Genus</small>
            </ul>
            </span>
            </div>
        <% if(data_lineage.subspecies){ %>
        <tr class='underline'><td class='bold text-right hilight'>Species:</td>
            <td class='taxon-data'> <a href='life?rank=species&name=<%= data_lineage.species %>'><%= data_lookup.species %></a></td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>Subspecies:<br>or Clade:</td>
            <td class='taxon-data white'><%= data_lineage.subspecies %></td>
        </tr>
        <% }else{ %>
        <tr class='underline'><td class='bold text-right hilight'>Species:</td>
            <td class='taxon-data white'><%= data_lookup.species %></td>
        </tr>
        <% } %>
        
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
            
        </tr> 
        
        <tr class='spaced-row'><td class='bold hilight' nowrap>Bacterial Name</td>
            <td class='taxon-data' nowrap><i><%= data_lineage.species %></i></td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight'  nowrap>Taxonomic Rank link</td>
            <td class='taxon-data' nowrap></td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight' nowrap>HOMD/NCBI/GTDB</td>
            <td class='taxon-data' nowrap></td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight' nowrap>NCBI Taxon-ID</td>
            <td class='taxon-data' nowrap>
            <% if(!data_lookup.ncbi_taxid || parseInt(data_lookup.ncbi_taxid) == 0){ %>
                <small>Not Available</small>
            <% }else{ %>
                <span class='link'>
                    <a href='https://www.ncbi.nlm.nih.gov/datasets/taxonomy/<%= data_lookup.ncbi_taxid %>/' target='_blank' rel="noopener noreferrer"><%= data_lookup.ncbi_taxid %> </a>
                </span>
            <% } %>
            </td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight' nowrap>LSPN Species Page</td>
            <td class='taxon-data' nowrap>
                <% link = "https://lpsn.dsmz.de/"+links["lpsnlink"] %>
                <% show = data_lineage.species %>
                <span>
                    <a class='link' href='<%- link %>' target='_blank' rel="noopener noreferrer"><em><%- link %></em></a>
                </span>
            </td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight' nowrap>Type Strain(s)</td>
            <td class='taxon-data' nowrap></td>
        </tr>
        <tr class=''><td class='line bold hilight' colspan='2'>&nbsp;</td>
        <tr class='spaced-row'><td class='bold hilight' nowrap>Former Names/Synonyms</td>
            <td class='taxon-data' nowrap>
            <table class='' border='0'>
                <% for(n=0;n<data_lookup.synonyms.length;n++){ %>
                <tr><td class='taxon-data' style='border:none;padding:0 1px;' nowrap><i><%- data_lookup.synonyms[n] %></i></td></tr>
                <% } %>
            </table>
            </td>
        </tr>
       
        
        
        
        
        </table>
       
    
    </div>
   
    
    <div class='' id='genomics-area'>
        <table>
        <tr><td class='bold hilight head'>Genomics</td></tr>
        <tr class='spaced-row'><td class='bold hilight' nowrap>Taxon Genomes</td>
            <td class='taxon-data' nowrap>
            <% g_length = data_lookup.genomes.length %>
            <% if(g_length === 0){ %>
                <small>No Genomes</small>
            <% }else{ %>
                <%= g_length %> <a class='td-button' href='/genome/genome_table?otid=<%= otid %>'> Open Genomes in Table</a>
            <% } %>
            </td>
        </tr>
        <tr class='spaced-row' colspan='2'><td class='bold hilight' nowrap>Phylogenetic Trees
           <br>
           &nbsp;&nbsp;&nbsp;&nbsp;Conserved Proteins<br>
           &nbsp;&nbsp;&nbsp;&nbsp;Ribosomal Proteins
        </td>
        <td>
        <br><a class='link' href='/genome/conserved_protein_tree?otid=<%= otid %>' target='_blank'>Open</a>
        <br><a class='link' href='/genome/ribosomal_protein_tree?otid=<%= otid %>' target='_blank'>Open</a>
        </td>
        
        </tr>
        <tr class='spaced-row' colspan='2'><td class='bold hilight' nowrap>BLAST against
            <br>
            &nbsp;&nbsp;&nbsp;&nbsp;All Genomes<br>
           &nbsp;&nbsp;&nbsp;&nbsp;One Genome
        </td>
        <td>
         <br><a class="dropdown-item" href="<%= cfg.BLAST_URL_BASE %>/genome_blast">link</a>
         <br><a class='td-button'     href='/genome/genome_table?otid=<%= otid %>'> Select Genome from Table</a>
        </td>
        
        </table>
    
    </div>
    
    <div class='' id='pangenomics-area'>
        <table>
        <tr><td class='bold hilight head'>Pangenomics</td></tr>
        <tr><td class='bold hilight'>Preview:</td>
            <td class='taxon-data' nowrap>
            
            <% if(data_lookup.pangenomes.length == 1 && data_lookup.pangenomes[0]){ %>
                <a class='link' href='/genome/pangenome_image2?pg=<%= data_lookup.pangenomes[0].pg %>&ext=svg' target='_blank'>OpenSVG</a> 
            <% }else if(data_lookup.pangenomes.length > 1 && data_lookup.pangenomes[0]){ %>
            <% for(n in data_lookup.pangenomes){ %>
                <a class='link' href='/genome/pangenome_image2?pg=<%= data_lookup.pangenomes[n].pg %>&ext=svg' target='_blank'>OpenSVG</a> 
            <%   } %>
            <% }else{ %>
                <small>No Pangenomes Available.</small>
            <% } %>
                        
                        </td>
                    </tr>
                    <tr><td class='bold text-right hilight'>Open Anvi`o:</td>
                        <td class='taxon-data' nowrap>
                        
                        
            <% if(data_lookup.pangenomes.length == 1 && data_lookup.pangenomes[0]){ %>
                <a class='link' href='/genome/anvio?pg=<%= data_lookup.pangenomes[0].pg %>' target='_blank'>Open</a> 
            <% }else if(data_lookup.pangenomes.length > 1 && data_lookup.pangenomes[0]){ %>
            <%   for(n in data_lookup.pangenomes){ %>
                <a class='link' href='/genome/anvio?pg=<%= data_lookup.pangenomes[n].pg %>' target='_blank'>Open</a> 
            <%   } %>
            <% }else{ %>
                <small>No Pangenomes Available.</small>
            <% } %>
            </td>
        </tr>
       </table>
    </div>
   
   <!-- 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA 16S rRNA -->
    <div class='' id='rrna16s-area'>
      <table>
        <tr><td class='bold hilight head' nowrap>16S rRNA</td></tr>
        <tr class='underline'><td class='bold text-right hilight' nowrap>Taxon RefSeqs</td>
            <td class='taxon-data white'>TBA
            
            </td>
        </tr>
      </table>
    </div>
    <!-- ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY ECOLOGY -->
    <div class='' id='ecology-area'>
      <table>
        <tr><td class='bold hilight head' nowrap>Ecology</td></tr>
        <tr class='underline'><td class='bold text-right hilight' nowrap>Body Site/Habitat</td>
            <td class='taxon-data white'>
            
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight'>General</td>
            <td class='taxon-data white'>TBA
            
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight' nowrap>Major body site</td>
            <td class='taxon-data white'>TBA
            
            </td>
        </tr>
        <tr class='underline'><td class='bold text-right hilight' nowrap>Major oral site</td>
            <td class='taxon-data white'>TBA
            
            </td>
        </tr>
        </tr>
      </table>
    </div>
    
    <!-- PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE PHAGE -->
    <div class='' id='phage-area'>
      <table>
        <tr><td class='bold hilight head' nowrap>Phage</td></tr>
        <tr class='underline'><td class='bold text-right hilight' nowrap>Genomes with phage annotation</td>
            <td class='taxon-data white'>TBA
            
            </td>
        </tr>
      </table>
    </div>
    
  </div>  <!-- End Container -->

  
</div> <!-- end: page-content -->
    
    <div id='footer'>
         <%- include('../../partials/footer'); %>
    </div>
  </div> <!-- end wrapper   -->
</body>
</html>

