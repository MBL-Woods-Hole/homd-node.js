<style>
#table-div{
    background:steelblue;
    border:1px solid black;
    padding:100px;
    height:700px;
    overflow:auto;
}
table { width: 100%; border-collapse: collapse; font-family: sans-serif; border:2px solid grey;}
th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
th { background-color: #f4f4f4; }
tr:nth-child(even) { background-color: #f9f9f9; }
tr:nth-child(odd) { background-color: lightblue; }

#end-notice{
   color:red;
}
</style>
<%- include('../partials/header_html'); %>


<body>
    
    <div id='wrapper'>
    <%- include('../partials/header_img'); %>
    <%- include('../partials/navbar'); %>
    <div class='page-content' > 
    <h1><%= anno.toUpperCase() %> Grep Search Results for: <small>'<%= search_text %>'</small></h1>
    <center><span id='end-notice'>Streaming Search Results...</span></center>
    <div id='table-div'>
    <table class='sortable'>
        <thead>
            <tr>
                <th>Genome-ID</th>
                <th>HMT-ID</th>
                <th>Organism</th>
                <th>Protein-ID</th>
                <th>Gene</th>
                <th>Product</th>
                <th class="sorttable_nosort">GenomeViewer</th>
            </tr>
        </thead>
        <tbody id="table-body">
            <!-- Real-time data rows will append here -->
        </tbody>
    </table>
    </div>
    <script>
        //const outputDiv = document.getElementById('output');
        // Clear placeholder text
        //outputDiv.textContent = ''; 
         //outputDiv.innerHTML = "";
        // Connect to the SSE endpoint
        const eventSource = new EventSource('/get_grep_stream?anno=<%= anno %>&search_text=<%= search_text %>');

        eventSource.onmessage = function(event) {
            const eventData = JSON.parse(event.data);
            
            if (eventData.notice === 'END-OF-STREAM') {
                eventSource.close();
                
                const notification = document.getElementById('end-notice');
                notification.innerHTML = "DONE (row count: "+eventData.count.toString()+")"
                console.log('Stream ended by server.');
                return;
            }
            // Append the new line
            //console.log('e.data',event.data)
            //outputDiv.textContent += event.data + '<br>';
            
            //outputDiv.innerHTML += event.data +"<br>";
            // Auto-scroll to the bottom:
            //outputDiv.scrollTop = outputDiv.scrollHeight;
            try {
                // Parse incoming JSON data from the event stream
                //const eventData = JSON.parse(event.data);
                const tableBody = document.getElementById('table-body');
                // 3. Create a new table row element
                const row = document.createElement('tr');

                // 4. Create and populate cells
                const gidCell = document.createElement('td');
                gidCell.textContent = eventData.gid || "";

                const hmtCell = document.createElement('td');
                hmtCell.textContent = eventData.hmt || "";
                
                const orgCell = document.createElement('td');
                orgCell.textContent = eventData.org || "";
                
                const pidCell = document.createElement('td');
                pidCell.textContent = eventData.pid || "";

                const geneCell = document.createElement('td');
                geneCell.textContent = eventData.gene || "";
                
                const prodCell = document.createElement('td');
                prodCell.textContent = eventData.prod || "";
                
                const urlCell = document.createElement('td');
                urlCell.innerHTML = "<a href='"+eventData.jburl+"' target='_blank'>link</a>";
                
                // 5. Append cells to the row
                row.appendChild(gidCell);
                row.appendChild(hmtCell);
                row.appendChild(orgCell);
                row.appendChild(pidCell);
                row.appendChild(geneCell);
                row.appendChild(prodCell);
                row.appendChild(urlCell);
                
                // 6. Insert row into the table body
                // prepend() puts new events at the top. Use append() to put them at the bottom.
                tableBody.prepend(row); 

            } catch (error) {
                console.error("Error parsing event stream data:", error);
            }
        };

        eventSource.onerror = function(err) {
            console.log("Stream closed or ended ERROR.",err);
            
            eventSource.close();
        };
    </script>
    </div>
    </div>
</body>
</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script type="text/javascript" src="/js/sorttable.js"></script> <!-- https://www.kryogenix.org/code/browser/sorttable -->
<script type="text/javascript" src="/js/menu.js"></script>